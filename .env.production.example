# PostgreSQL Production Connection URL
DATABASE_URL="postgresql://innosom_user:secure_password_here@postgres-host:5432/innosom_production?schema=public"

# Redis Connection URL (for BullMQ publishing queue)
REDIS_URL="redis://:redis_password@redis-host:6379"

# Security Secrets (Must be 32+ bytes random strings)
JWT_SECRET="replace-with-secure-32-byte-secret-key-for-jwt"
ENCRYPTION_KEY="replace-with-64-character-hex-encryption-key-0123456789abcdef"

# Server Port & Domain
PORT=3000
NEXT_PUBLIC_APP_URL="https://social.innosom.com"

# Set to "true" in production to activate live platform integrations
ENABLE_LIVE_SOCIAL_APIS="true"

# Meta Graph API (Facebook & Instagram)
FACEBOOK_APP_ID="meta_app_id"
FACEBOOK_APP_SECRET="meta_app_secret"
INSTAGRAM_APP_ID="meta_app_id"
INSTAGRAM_APP_SECRET="meta_app_secret"

# TikTok Open API v2
TIKTOK_APP_ID="tiktok_client_key"
TIKTOK_APP_SECRET="tiktok_client_secret"

# Google / YouTube Data API v3
YOUTUBE_CLIENT_ID="youtube_client_id"
YOUTUBE_CLIENT_SECRET="youtube_client_secret"
