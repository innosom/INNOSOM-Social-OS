# Database Connection URL:
# For Local Development (SQLite):
# DATABASE_URL="file:./dev.db"
# For Production / Staging (PostgreSQL):
DATABASE_URL="postgresql://user:password@localhost:5432/innosom_db?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="innosom-super-secret-jwt-encryption-key-32-bytes!!"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" to enable live Social API Adapters (Facebook Graph API, Instagram Graph API, TikTok API v2, YouTube Data API v3)
ENABLE_LIVE_SOCIAL_APIS="false"

# Meta Graph API (Facebook & Instagram)
FACEBOOK_APP_ID="your_meta_app_id"
FACEBOOK_APP_SECRET="your_meta_app_secret"
INSTAGRAM_APP_ID="your_meta_app_id"
INSTAGRAM_APP_SECRET="your_meta_app_secret"

# TikTok Open API v2
TIKTOK_APP_ID="your_tiktok_client_key"
TIKTOK_APP_SECRET="your_tiktok_client_secret"

# Google / YouTube Data API v3
YOUTUBE_CLIENT_ID="your_youtube_client_id"
YOUTUBE_CLIENT_SECRET="your_youtube_client_secret"
